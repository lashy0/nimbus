# Workaround for idf-component-manager 2.4.6: esp_lvgl_port accepts lvgl >=8,<10, and
# while solving, the rules of the rejected lvgl 9.x candidate reference these LVGL 9
# options. LVGL 8.4 has no such options, so the build stops with "Missing required
# kconfig option". The symbols need prompts: kconfiglib does not export an invisible
# bool that is n, and the component manager then still reports it as missing.
# LV_USE_FREETYPE is defined by LVGL 8 itself.
menu "Nimbus: LVGL 9 options for the component manager (unused)"

    config LV_USE_LIBJPEG_TURBO
        bool "LV_USE_LIBJPEG_TURBO placeholder, keep disabled"
        default n

    config LV_USE_LIBPNG
        bool "LV_USE_LIBPNG placeholder, keep disabled"
        default n

    config LV_USE_LZ4
        bool "LV_USE_LZ4 placeholder, keep disabled"
        default n

    config LV_USE_LZ4_INTERNAL
        bool "LV_USE_LZ4_INTERNAL placeholder, keep disabled"
        default n

endmenu
