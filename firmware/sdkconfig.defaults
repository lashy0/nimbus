# Target and flash
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Partitions
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Core dump: kept in flash after a crash
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# Task watchdog: reset on a timeout
CONFIG_ESP_TASK_WDT_PANIC=y

# LVGL: what Kconfig cannot set is in components/ui/lv_conf.h
CONFIG_LV_CONF_SKIP=n
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
# Files from the assets partition as S:img/...
CONFIG_LV_USE_FS_STDIO=y
CONFIG_LV_FS_STDIO_LETTER=83
CONFIG_LV_FS_STDIO_PATH="/assets/"

# SPIFFS: asset paths are longer than the default 32 characters
CONFIG_SPIFFS_OBJ_NAME_LEN=64

# Light sleep
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

# Buttons: 50 ms debounce
CONFIG_BUTTON_PERIOD_TIME_MS=10
CONFIG_BUTTON_DEBOUNCE_TICKS=5
