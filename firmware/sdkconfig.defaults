CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=16
CONFIG_ESP_COREDUMP_STACK_SIZE=2048
# CONFIG_ESP_COREDUMP_CAPTURE_DRAM is not set

CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# espressif/button: 10 ms polling x 5 ticks = 50 ms debounce.
CONFIG_BUTTON_PERIOD_TIME_MS=10
CONFIG_BUTTON_DEBOUNCE_TICKS=5
# Its power-save wake ISR is IRAM and calls gpio_intr_disable(); in flash that
# panics with a cache error when a press arrives during a SPIFFS read.
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

# LVGL 9.5: RGB565 rendered in CPU byte order (the display flush swaps the bytes
# for the ST7789), heap allocation, assets via S:/spiffs/...
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_FS_STDIO=y
CONFIG_LV_FS_STDIO_LETTER=83
CONFIG_LV_FS_STDIO_CACHE_SIZE=4096
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y
# Images are files in SPIFFS: without a cache every draw band reopens and rereads
# them, and a page switch took 105-139 ms instead of 35-43 ms. 48 KiB holds the
# images of the largest page, both blink frames included.
CONFIG_LV_CACHE_DEF_SIZE=49152
CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=32
CONFIG_LV_BIN_DECODER_RAM_LOAD=y
# Examples and demos are not part of the firmware.
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set

# SPIFFS paths such as /img/face/temp_normal_closed_eyes.bin exceed the default 32.
CONFIG_SPIFFS_OBJ_NAME_LEN=64
