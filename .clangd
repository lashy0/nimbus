# clangd only: the firmware is built by ESP-IDF with xtensa GCC in firmware/build.
If:
  PathExclude: simulator/.*
CompileFlags:
  CompilationDatabase: firmware/build
  # GCC-only options from the ESP-IDF build that clang rejects.
  Remove:
    - -mlongcalls
    - -fno-shrink-wrap
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fzero-init-padding-bits=*
    - -fno-malloc-dce

Diagnostics:
  Includes:
    # FreeRTOS requires this header before task.h, queue.h and semphr.h.
    IgnoreHeader: 'freertos/FreeRTOS\.h'

---
# Desktop SDL/LVGL files need their own includes, defines and host compiler.
If:
  PathMatch: simulator/.*
CompileFlags:
  CompilationDatabase: .cache/preview
